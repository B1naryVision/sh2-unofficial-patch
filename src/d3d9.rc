#include <windows.h>

// Version metadata for the patch DLL. Not cosmetic: a binary with no version
// resource at all is what SmartScreen and antivirus heuristics like least, and
// this one already looks unusual to a scanner (a d3d9.dll proxy that rewrites
// game code and hooks the keyboard). Naming the project, the licence and the
// source repository here is the cheapest provenance signal available short of
// code signing. Keep FILEVERSION in step with CHANGELOG.md.

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,7,1,0
PRODUCTVERSION  0,7,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Stronghold 2 Unofficial Patch"
            VALUE "FileDescription",  "Stronghold 2 Unofficial Patch (Direct3D 9 proxy)"
            VALUE "FileVersion",      "0.7.1.0"
            VALUE "InternalName",     "sh2-unofficial-patch"
            VALUE "OriginalFilename", "d3d9.dll"
            VALUE "ProductName",      "Stronghold 2 Unofficial Patch"
            VALUE "ProductVersion",   "0.7.1.0"
            VALUE "LegalCopyright",   "Public domain (Unlicense)"
            VALUE "Comments",         "Community bug-fix and quality-of-life patch for Stronghold 2. Loads as a Direct3D 9 proxy and forwards every call to the system d3d9.dll. Source: github.com/B1naryVision/sh2-unofficial-patch"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
